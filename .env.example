# Copy this file to .env and fill in real values. Never commit .env.

# --- Reverse image search (SerpApi, Google Lens engine) ---------------------
SERPAPI_API_KEY=

# --- IPFS pinning (Pinata) ---------------------------------------------------
# JWT-based auth, per Pinata's current API. If left unset, IPFS pinning is
# skipped (controlled, non-fatal) and manifestURI is registered as "".
PINATA_JWT=

# --- Polygon Amoy testnet ----------------------------------------------------
POLYGON_AMOY_RPC_URL=
CHAIN_ID=80002
CONTRACT_ADDRESS=
# Funded testnet wallet private key. NEVER use a wallet holding real funds.
PRIVATE_KEY=
EXPLORER_BASE_URL=https://amoy.polygonscan.com/tx/

# --- Pipeline tuning ----------------------------------------------------------
FACE_DISTANCE_THRESHOLD=0.6
HTTP_TIMEOUT_SECONDS=10
MAX_SEARCH_RESULTS=20
